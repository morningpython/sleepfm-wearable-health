# =====================================================
# SleepFM Backend Environment Variables
# =====================================================
# Copy this file to .env and fill in the values
# NEVER commit .env files to version control
# =====================================================

# ==========================================
# Application Settings
# ==========================================
PROJECT_NAME=SleepFM Backend API
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
API_PREFIX=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sleepfm
DATABASE_ECHO=False
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sleepfm

# ==========================================
# Redis Configuration
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Celery Task Queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ==========================================
# Security Settings
# ==========================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ==========================================
# CORS Settings
# ==========================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# ==========================================
# Monitoring & Logging
# ==========================================
# Sentry (Error Tracking)
SENTRY_DSN=

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Logging
LOG_FILE=logs/app.log

# ==========================================
# Storage Settings
# ==========================================
STORAGE_TYPE=local
STORAGE_PATH=./data
MAX_UPLOAD_SIZE_MB=50

# AWS S3 (Production)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=sleepfm-data
# AWS_REGION=us-east-1

# ==========================================
# External Services
# ==========================================
# Apple Health Kit (iOS)
APPLE_HEALTHKIT_ENABLED=true

# Google Fit (Android)
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=

# ==========================================
# Email Configuration (Optional)
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@sleepfm.io

# ==========================================
# Feature Flags
# ==========================================
FEATURE_ML_PREDICTIONS=true
FEATURE_SLEEP_INSIGHTS=true
FEATURE_BETA_FEATURES=false

# ==========================================
# Grafana (Monitoring Dashboard)
# ==========================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_URL=http://localhost:3000
