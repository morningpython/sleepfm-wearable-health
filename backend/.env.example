# 환경 변수 예시
# 프로덕션 환경에서는 실제 값으로 변경하세요

# 기본 설정
PROJECT_NAME=SleepFM Backend API
DEBUG=True
API_PREFIX=/api/v1

# 서버 설정
HOST=0.0.0.0
PORT=8000

# 데이터베이스
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sleepfm
DATABASE_ECHO=False

# JWT 설정
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 설정
CORS_ORIGINS=["*"]

# 스토리지 설정
STORAGE_TYPE=local
STORAGE_PATH=./data
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=sleepfm-data
# AWS_REGION=us-east-1

# 로깅 설정
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
